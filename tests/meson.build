# The players of a movie (Chimera's rows), the machine's and the oracle's, each printing a hash at every frame end
o4dbPlay = executable('o4dbPlay', 'o4dbPlay.c', dependencies : [ quickerOpen4DBoxingDependency ])
o4dbOracle = executable('o4dbOracle', 'o4dbOracle.c', dependencies : [ open4dboxingDependency ])
